tolerance 5.0
output box.pdb
connect yes
add_box_sides 0.5
filetype pdb
seed -1

# Bottom fluid slab
structure fluid.pdb
  number 1
  fixed 80 80 70.0 0.0 0.0 0.0
end structure

# Membrane in the middle
structure membrane.pdb
  number 1
  fixed 80 80  225.0 0.0 0.0 0.0
end structure

# Top fluid slab
structure fluid.pdb
  number 1
  fixed 80 80  335.0 0.0 0.0 0.0
end structure
